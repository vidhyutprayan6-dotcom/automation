# Copy to .env and fill in (never commit .env)
TELEGRAM_BOT_TOKEN=paste_your_bot_token_here

# Optional. Primary display is detected automatically.
# If detection fails, run `ffmpeg -f avfoundation -list_devices true -i ""`
# and set the numeric index shown beside "Capture screen 0".
# SCREEN_RECORD_INPUT=1

# Seconds per recording segment while automation is running.
# Default is 1800 (30 minutes). Remainder under 30 minutes is uploaded when
# the automation task ends. The recorder service itself stays running with the bot.
# SCREEN_RECORD_SECONDS=1800
